{
  "name": "@theqrl/validate-qrl-address",
  "version": "3.0.1",
  "description": "Validates QRL addresses",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --global-name=validateQrlAddress --footer:js=\"if (typeof module === 'object' && module.exports) { module.exports = validateQrlAddress; }\" --outfile=dist/validateQrlAddress.js",
    "test": "mocha --reporter spec",
    "cover": "c8 --reporter=lcov --reporter=text mocha --reporter spec"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theQRL/validate-qrl-address.git"
  },
  "author": "QRL contributors <info@theqrl.org> (https://theqrl.org)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theQRL/validate-qrl-address/issues"
  },
  "homepage": "https://github.com/theQRL/validate-qrl-address#readme",
  "dependencies": {
    "sha256": "^0.2.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^12.0.3",
    "prettier": "3.10.1"
  },
  "overrides": {
    "mocha": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  }
}
